<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16.0dip"
    android:paddingBottom="24.0dip">

    <FrameLayout
        android:id="@+id/custom_model_phone_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12.0dip"
        android:layout_marginBottom="16.0dip">

        <ImageView
            android:id="@+id/custom_model_image"
            android:layout_width="140.0dip"
            android:layout_height="230.0dip"
            android:scaleType="fitCenter"
            android:src="@drawable/hk_about_device_image" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/custom_model_grid_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/hk_about_card_bg"
        app:cardCornerRadius="18.0dip"
        app:cardElevation="0.0dip"
        app:strokeWidth="0.0dip">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18.0dip">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12.0dip"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/custom_model_brand_name"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="20.0sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/custom_model_brand_logo"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:scaleType="fitCenter"
                    android:src="@drawable/hk_about_brand_logo" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.75dip"
                android:layout_marginBottom="18.0dip"
                android:background="#1f808080" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignBounds"
                android:columnCount="2">

                <LinearLayout
                    android:layout_width="0.0dip"
                    android:layout_columnWeight="1.0"
                    android:orientation="vertical"
                    android:paddingEnd="8.0dip"
                    android:paddingBottom="22.0dip">

                    <TextView
                        android:id="@+id/custom_model_device_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17.0sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/hk_about_model_title"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.0sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0.0dip"
                    android:layout_columnWeight="1.0"
                    android:orientation="vertical"
                    android:paddingStart="8.0dip"
                    android:paddingBottom="22.0dip">

                    <TextView
                        android:id="@+id/custom_model_serial_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17.0sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/status_serial_number"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.0sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0.0dip"
                    android:layout_columnWeight="1.0"
                    android:orientation="vertical"
                    android:paddingEnd="8.0dip"
                    android:paddingBottom="22.0dip">

                    <TextView
                        android:id="@+id/custom_model_platform_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17.0sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/hk_about_platform_title"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.0sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0.0dip"
                    android:layout_columnWeight="1.0"
                    android:orientation="vertical"
                    android:paddingStart="8.0dip"
                    android:paddingBottom="22.0dip">

                    <TextView
                        android:id="@+id/custom_model_ram_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17.0sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/hk_about_ram_total_title"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.0sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0.0dip"
                    android:layout_columnWeight="1.0"
                    android:orientation="vertical"
                    android:paddingEnd="8.0dip">

                    <TextView
                        android:id="@+id/custom_model_hardware_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17.0sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/hk_about_hardware_version_title"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.0sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0.0dip"
                    android:layout_columnWeight="1.0"
                    android:orientation="vertical"
                    android:paddingStart="8.0dip">

                    <TextView
                        android:id="@+id/custom_model_codename_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17.0sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/hk_about_codename_title"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.0sp" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
