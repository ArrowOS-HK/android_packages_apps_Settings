<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/about_device_info_cards"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16.0dip">

    <LinearLayout
        android:id="@+id/hk_about_device_tile"
        android:layout_width="0.0dip"
        android:layout_height="128.0dip"
        android:layout_marginEnd="6.0dip"
        android:layout_weight="1.0"
        android:background="@drawable/hk_about_tile_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="18.0dip"
        android:paddingTop="14.0dip"
        android:paddingEnd="16.0dip"
        android:paddingBottom="16.0dip">

        <ImageView
            android:layout_width="28.0dip"
            android:layout_height="28.0dip"
            android:src="@drawable/hk_ic_about_device_filled"
            android:tint="?android:attr/colorAccent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />

        <TextView
            android:id="@+id/hk_device_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_device_info_device_name_preference_title"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13.0sp" />

        <TextView
            android:id="@+id/hk_device_name_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            android:ellipsize="end"
            android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16.0sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hk_about_storage_tile"
        android:layout_width="0.0dip"
        android:layout_height="128.0dip"
        android:layout_marginStart="6.0dip"
        android:layout_weight="1.0"
        android:background="@drawable/hk_about_tile_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="18.0dip"
        android:paddingTop="14.0dip"
        android:paddingEnd="18.0dip"
        android:paddingBottom="16.0dip">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip"
            android:background="@drawable/hk_about_storage_progress_bg"
            android:clipToOutline="true">

            <com.android.settings.deviceinfo.aboutphone.ColorfulRatioBar
                android:id="@+id/hk_storage_progress"
                android:layout_width="match_parent"
                android:layout_height="12.0dip" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />

        <TextView
            android:id="@+id/hk_storage_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hk_about_storage_title"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13.0sp" />

        <TextView
            android:id="@+id/hk_storage_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            android:ellipsize="end"
            android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16.0sp" />
    </LinearLayout>
</LinearLayout>
